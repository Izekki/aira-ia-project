{
  "name": "aira-ia-project",
  "version": "1.0.0",
  "description": "Asistente personal inteligente de escritorio llamado **Aira**.",
  "main": "packages/server/index.js",
  "scripts": {
    "config:watch": "node scripts/sync-voice-config-watch.js",
    "client": "set \"BROWSER=msedge\" && npm start --prefix packages/client",
    "server": "node packages/server/index.js",
    "mock:vibev": "node scripts/mock-vibev-ws.js",
    "dev": "concurrently \"npm run config:watch\" \"npm run server\" \"npm run client\"",
    "build:client": "npm run build --prefix packages/client",
    "desktop": "npm run build --prefix packages/client && npm run build --prefix packages/desktop",
    "desktop:dev": "npm run dev --prefix packages/desktop",
    "mcp:server": "node packages/mcp-server/index.js",
    "mcp:dev": "node --watch packages/mcp-server/index.js",
    "mcp:install": "npm install --prefix packages/mcp-server",
    "dev:full": "concurrently \"npm run config:watch\" \"npm run server\" \"npm run client\" \"npm run mcp:server\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Izekki/aira-ia-project.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Izekki/aira-ia-project/issues"
  },
  "homepage": "https://github.com/Izekki/aira-ia-project#readme",
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@picovoice/pvrecorder-node": "^1.2.8",
    "@supabase/supabase-js": "^2.100.1",
    "dotenv": "^17.3.1",
    "onnxruntime-node": "^1.24.3",
    "openai": "^6.33.0",
    "socket.io": "^4.8.3",
    "ws": "^8.20.0"
  }
}
